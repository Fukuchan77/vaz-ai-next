{
	// TS config for apps/worker (a long-running Node 24 worker). Inherits the
	// framework-agnostic strict base. Unlike apps/web it adds no DOM lib / jsx /
	// next plugin — the worker is a pure Node process (durable workflow runner)
	// with no React/DOM. `pnpm --filter @vaz/worker run typecheck` uses this local
	// tsconfig to type-check src/ (a per-app tsconfig, like apps/web).
	"extends": "../../packages/config/tsconfig.base.json",
	"compilerOptions": {
		"incremental": true,
		// The worker is a pure Node process; pull in only @types/node (no DOM) to
		// resolve Node globals like process/Buffer.
		"types": ["node"]
	},
	// tests/ is not included — like apps/web: tests run typed under Vitest
	// (globals: true), and the gate's tsc checks only src/ (keeping the Vitest
	// global types out of the gate).
	"references": [],
	"include": ["src"],
	"exclude": ["node_modules"]
}
