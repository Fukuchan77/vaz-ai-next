{
	// 全 @vaz/* パッケージと apps が共有する framework-agnostic な strict base。
	// React Compiler / Next / DOM lib / jsx はここに含めない
	// ―― これらの適用境界は apps/web(next.config.ts で reactCompiler: true)側に置く。
	// 各パッケージ/アプリはこの base を extends し、固有設定のみを上書きする。
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}
