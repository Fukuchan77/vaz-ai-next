{
	// Framework-agnostic strict base shared by all @vaz/* packages and apps.
	// React Compiler / Next / DOM lib / jsx are NOT included here — those
	// application boundaries live in apps/web (reactCompiler: true in next.config.ts).
	// Each package/app extends this base and overrides only its own specifics.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true
	}
}
