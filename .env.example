# =============================================================================
# vaz-ai-next 環境変数サンプル
#
# 宛先が 3 つある。値はすべて「ホストから見た」既定値にしてあるので、
# 丸ごとコピーして必要なキーだけ埋めれば 1〜2 はそのまま動く。
#
#   [1] apps/web/.env.local     Next.js が読む。dev サーバの cwd は apps/web で、
#                               Next は親ディレクトリへ遡らないためリポジトリ直下の
#                               .env は読まれない。→ cp .env.example apps/web/.env.local
#   [2] .env（リポジトリ直下）   docker compose の ${...} 展開だけに使う。compose が
#                               読むのは 13 キーだけ（§compose の 8 キー ＋ AI_PROVIDER・
#                               ANTHROPIC_API_KEY・OLLAMA_BASE_URL・INNGEST_EVENT_KEY・
#                               INNGEST_SIGNING_KEY）で、残りは無害に無視される。
#                               → cp .env.example .env
#   [3] services/agent/.env     Python サイドカーの pydantic-settings（任意）。
#                               サイドカーを使うときだけ。→ §sidecar 参照
#
# ホスト名の使い分け（間違えやすい）:
#   コンテナ間の URL（postgres://…@db:5432、http://engine:8288）は
#   docker-compose.yml が worker/engine の environment に直接書いており、直下の .env
#   から展開していない。つまり .env / .env.local に書く DATABASE_URL・REDIS_URL・
#   INNGEST_BASE_URL は「ホストのプロセス（next dev / db:migrate / ingest CLI）が
#   見る値」であって localhost で正しい。compose 内部名を書くと解決できず落ちる。
# =============================================================================

# --- AI provider (packages/schemas/src/env.ts) -------------------------------
# anthropic または ollama。省略時は anthropic
AI_PROVIDER=anthropic
# 省略時は claude-opus-4-8
ANTHROPIC_MODEL=claude-opus-4-8
# AI_PROVIDER=anthropic のとき必須
ANTHROPIC_API_KEY=
# 省略時は http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
# 省略時は llama3.2
OLLAMA_MODEL=llama3.2

# --- Embedding (packages/schemas/src/env.ts) ---------------------------------
# 現状 ollama のみ実装。省略時は ollama
AI_EMBEDDING_PROVIDER=ollama
# 省略時は nomic-embed-text（768 次元 = DDL 固定。変更には migration + 全再 ingest）
AI_EMBEDDING_MODEL=nomic-embed-text

# --- Chat runtime (packages/schemas/src/env.ts) ------------------------------
# 1 ラン累計の input+output トークン上限。省略時は 200000
CHAT_TOKEN_BUDGET=200000

# --- HITL 承認の署名鍵 (packages/agents/src/approval-signing.ts, R5.6) -------
# 破壊的ツール（sendEmail）の承認応答はクライアント由来のデータで、AI SDK が承認要求へ
# 付ける HMAC 署名の検証だけが偽造を防いでいる。鍵を渡さないと SDK は検証パスを丸ごと
# スキップするため、クライアントが自分の呼び出しを自分で承認できてしまう。
# 未設定なら承認ポリシーは 'user-approval' ではなく 'denied' を返して fail closed する
# （認証できない承認で破壊的操作を通さない）。
# 省略可: 未設定なら AUTH_SECRET を使う。専用鍵を置く場合は 32 文字以上。
#   openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# --- Auth (packages/schemas/src/auth-env.ts, apps/web/src/lib/auth.ts) ------
# entra-id または google-workspace。省略時は entra-id
AUTH_IDP=entra-id
# Auth.js のセッション暗号化に必須。TOOL_APPROVAL_SECRET 未設定時は承認署名も兼ねる
#   openssl rand -base64 32
AUTH_SECRET=
# AUTH_IDP=entra-id のとき必須（Auth.js が命名規約で自動検出。_ISSUER のみ明示的に渡す）
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# AUTH_IDP=google-workspace のとき必須
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 注: admin ロールは IdP claim ではなく packages/config/src/role-allowlist.ts の
#     ADMIN_EMAILS（commit された allow-list）で決まる。env では付与できない。
#     sendEmail の宛先許可も同様に packages/tools/src/allowlist.ts が正本。

# --- Infra (packages/schemas/src/infra-env.ts) -------------------------------
# 必須。ホスト側プロセス（next dev / mise run db:migrate / ingest CLI）が使う値。
# compose の worker は自前で db:5432 を組み立てるのでここは localhost が正しい。
# POSTGRES_USER/PASSWORD/DB/PORT を変えたら、この URL も同じ値に揃える。
DATABASE_URL=postgres://vaz:vaz@localhost:5432/vaz
# 省略時は redis://redis:6379（compose 内部名）なので、ホスト側では明示が必要
REDIS_URL=redis://localhost:6379

# --- Inngest (apps/worker/src/inngest.ts — SDK が直接読む) -------------------
# ホストから engine コンテナへ。compose の worker には http://engine:8288 が
# docker-compose.yml 側で直接与えられており、ここからは展開されない。
INNGEST_BASE_URL=http://localhost:8288
# dev モードは 1。compose の worker は INNGEST_DEV="0" 固定
INNGEST_DEV=1
# 空なら compose 側の dev 既定値（dev_event_key / 0 の 64 桁 hex）が使われる。
# 本番は必ず実鍵を注入する: openssl rand -hex 32
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Telemetry (packages/config/src/telemetry.ts、任意) ----------------------
# 両方揃ったときだけ Langfuse への OTLP エクスポートが有効になる（fail-soft）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Worker (apps/worker、任意) ----------------------------------------------
# 複数ワーカーを走らせるときのログ/監査上の識別子
WORKER_INSTANCE_ID=

# --- Python サイドカー呼び出し元 (packages/rag, packages/evals) --------------
# ingest --via-parser（必須・fail-fast）と tier2 eval が叩く先。
# サイドカーを compose で上げた場合は AGENT_SERVICE_PORT に合わせる
AGENT_SERVICE_URL=http://localhost:8000

# --- Evals (packages/evals、任意) --------------------------------------------
# nightly のトークン上限。未設定なら上限なし
EVAL_NIGHTLY_COST_CAP_TOKENS=
PR_GATE_BASELINE_PATH=
PR_GATE_OUTPUT_PATH=

# =============================================================================
# §compose — [2] リポジトリ直下 .env でのみ効く（docker compose の ${...} 展開）
# これ以外のキーは compose からは参照されない。逆にここのキーは Next.js からは
# 使われない（アプリは DATABASE_URL/REDIS_URL を直接読む）。
# =============================================================================

# db サービスの初期化に使う。既存ボリュームがあると変更しても反映されない
# （volume を消して作り直すこと）。DATABASE_URL と必ず揃える。
POSTGRES_USER=vaz
POSTGRES_PASSWORD=vaz
POSTGRES_DB=vaz

# ホスト側の公開ポート。既に使っている場合だけ変える
POSTGRES_PORT=5432
REDIS_PORT=6379
INNGEST_PORT=8288
INNGEST_CONNECT_PORT=8289
AGENT_SERVICE_PORT=8000

# 注: worker/sidecar コンテナへ渡る AI_PROVIDER / ANTHROPIC_API_KEY /
#     OLLAMA_BASE_URL は上の各節と同じキーを compose が展開する。ホストの Ollama を
#     使うなら OLLAMA_BASE_URL=http://host.docker.internal:11434/v1 が必要。

# =============================================================================
# §sidecar — [3] services/agent/.env（services/agent/app/config.py、任意）
# pydantic-settings が cwd の .env を読む。cwd は services/agent
# （mise run py:check / uv run uvicorn app.main:app のいずれも）。
# compose の sidecar プロファイルで動かす場合、ANTHROPIC_API_KEY だけは
# docker-compose.yml が直下の .env から展開して渡すのでここは不要。
# =============================================================================

# anthropic または ollama。省略時は anthropic
JUDGE_PROVIDER=anthropic
# 省略時は provider ごとの既定（config.py の JUDGE_MODEL_ALLOWLIST 先頭）。
# allowlist 外の値を入れると起動時に ValueError で落ちる
JUDGE_MODEL=
# /parse の LlamaParse opt-in を開ける。未設定なら use_llamaparse 要求でも
# 常に Docling へフォールバックする（エラーにはならない）
LLAMAPARSE_API_KEY=
