	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@playwright/test": "~1.58.2",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.5.2",
		"@types/node": "^22.13.0",
		"@types/react": "^19.0.0",
