#!/bin/sh
# Pre-push quality gate: E2E tests (Playwright).
# playwright.config.ts starts the webServer via `--filter @vaz/web`.
# E2E runs via mise tasks (mise.toml is the source of truth / CLAUDE.md: no bare tools).
# If a local Ollama is running, it runs with AI_PROVIDER=ollama, which also exercises
# the real local-LLM chat round-trip (apps/web/tests/e2e/chat-ollama.spec.ts).
# To skip temporarily: git push --no-verify
set -e

OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://localhost:11434/v1}"

if [ -z "$AI_PROVIDER" ] && command -v curl >/dev/null 2>&1 &&
	curl -fsS --max-time 2 "$OLLAMA_BASE_URL/models" >/dev/null 2>&1; then
	export AI_PROVIDER=ollama
	echo "[pre-push] Ollama detected — running E2E with AI_PROVIDER=ollama"
fi

echo "[pre-push] E2E tests (playwright, webServer=@vaz/web)"
mise run test:e2e

echo "[pre-push] ✅ all checks passed"
